$amfaVer = @trim(@file_get_contents('/usr/local/emhttp/plugins/aegis.mfa/VERSION') ?: '');
if ($amfaVer === '') {
    $amfaPlg = @file_get_contents('/boot/config/plugins/aegis.mfa/aegis.mfa.plg');
