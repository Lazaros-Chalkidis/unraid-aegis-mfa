require_once '/usr/local/emhttp/plugins/aegis.mfa/include/AegisMfaAdmin.php';
require_once '/usr/local/emhttp/plugins/aegis.mfa/include/AegisMfaEnroll.php';
require_once '/usr/local/emhttp/plugins/aegis.mfa/include/AegisMfaInstall.php';

$amfaEsc = fn($s) => htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8');
$amfaNotice = ''; $amfaNoticeKind = 'ok'; $amfaNewCodes = null; $amfaBypassUrl = null;

// our own token: every action below changes authentication state, too much to leave to an upstream check
aegis_mfa_mark_seen(aegis_mfa_current_user());

$amfaCsrf = aegis_mfa_csrf_token();
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['amfa_action'])
    && !aegis_mfa_csrf_check((string)($_POST['amfa_csrf'] ?? ''))) {
    unset($_POST['amfa_action']);
    $amfaNotice = 'Session expired, nothing was changed. Reload the page and try again.';
    $amfaNoticeKind = 'err';
}

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['amfa_action'])) {
    switch ($_POST['amfa_action']) {

        case 'toggle':
            $on = ($_POST['enabled'] ?? '') === '1';
            aegis_mfa_set_enabled($on);
            if ($on && (int)aegis_mfa_config(true)['enforce_after'] === 0) {
                aegis_mfa_start_dry_run(24);
            }
            $r = aegis_mfa_reconcile_patches();
            if ($on && ($r['ok'] ?? false)) {
                aegis_mfa_sync_users();
            }
            if ($on && !($r['ok'] ?? false)) {
                aegis_mfa_set_enabled(false);
                aegis_mfa_reconcile_patches();
                $amfaNotice = 'Could not enable: the Unraid login files are not in the expected '
                            . 'shape (' . ($r['reason'] ?? 'unknown') . '). Nothing was changed '
                            . 'and MFA stays off. This usually means Unraid restructured these files, '
                            . 'or another plugin has patched them.';
                $amfaNoticeKind = 'err';
            } elseif (!$on) {
                $amfaNotice = 'MFA disabled, login patches removed.';
            } elseif (aegis_mfa_enforcing()) {
                // a dry run only starts while enforce_after is 0, so a re-enable after enforce goes straight to enforcing
                $amfaNotice = 'MFA enabled and enforcing straight away, this server already '
                            . 'finished its dry run. A code is required at the next login.';
            } else {
                $amfaNotice = 'MFA enabled. A dry run is running, see the banner below to enforce now.';
            }
            break;

        case 'enforce_now':
            aegis_mfa_enforce_now();
            $amfaNotice = 'MFA is now enforcing.';
            break;

        case 'save_lan':
            $lines = preg_split('/[\s,]+/', (string)($_POST['trust_lan'] ?? ''));
            $r = aegis_mfa_set_trust_lan($lines);
            $amfaNotice = count($r['rejected'])
                ? 'Saved. Rejected invalid entries: ' . implode(', ', $r['rejected'])
                : 'Trusted LAN saved.';
            if (count($r['rejected'])) $amfaNoticeKind = 'warn';
            break;

        case 'save_grace':
            aegis_mfa_set_grace_days((int)($_POST['grace_days'] ?? 2));
            $amfaNotice = 'Grace period saved.';
            break;

        case 'regen_codes':
            $amfaNewCodes = aegis_mfa_begin_backup_regen((string)($_POST['user'] ?? ''));
            if ($amfaNewCodes === null) {
                $amfaNotice = 'Account is not enrolled.';
                $amfaNoticeKind = 'err';
            } else {
                $amfaNotice = 'New backup codes are ready below. Your current codes keep working '
                            . 'until you confirm.';
            }
            break;

        case 'confirm_codes':
            $r = aegis_mfa_commit_backup_regen((string)($_POST['backup_confirm'] ?? ''));
            if (($r['ok'] ?? false) === true) {
                $amfaNotice = 'New backup codes are active. The old ones no longer work.';
            } else {
                $amfaNoticeKind = 'err';
                $amfaNotice = ($r['reason'] ?? '') === 'bad_confirm'
                    ? 'That code does not match. Copy one exactly as shown below.'
                    : 'Could not save the new codes. Your existing codes still work.';
            }
            break;

        case 'cancel_codes':
            aegis_mfa_cancel_backup_regen();
            $amfaNotice = 'Cancelled. Your existing backup codes still work.';
            break;

        case 'reset_user':
            aegis_mfa_reset_user((string)($_POST['user'] ?? ''), true);
            $amfaNotice = 'Account reset to pending, it must enrol again.';
            break;

        case 'bypass':
            $u = (string)($_POST['user'] ?? '');
            $tok = aegis_mfa_create_bypass_token($u, 86400);
            if ($tok !== null) {

                // path only, HTTP_HOST is attacker-controlled and a poisoned link would carry the token elsewhere
                $amfaBypassUrl = '/plugins/aegis.mfa/include/setup.php?user='
                               . rawurlencode($u) . '&token=' . $tok;
                $amfaNotice = 'One-time setup link created (valid 24h), shown once below. '
                            . 'Open it on this server, the path is relative to the webGUI address you are on.';
            } else {
                $amfaNotice = 'Could not create the link.'; $amfaNoticeKind = 'err';
            }
            break;

        case 'history_toggle':
            aegis_mfa_set_lockout_history(($_POST['history_on'] ?? '') === '1');
            $amfaNotice = ($_POST['history_on'] ?? '') === '1'
                ? 'Lockout history is kept. The cron saves it at most every ten minutes.'
                : 'Lockout history is no longer saved. Existing entries were left in place.';
            break;

        case 'unlock_ip':
        case 'delete_lock':
            $amfaIp = (string)($_POST['lock_ip'] ?? '');
            if (aegis_mfa_forget_lockout($amfaIp)) {
                $amfaNotice = $_POST['amfa_action'] === 'unlock_ip'
                    ? 'Unlocked. The address can try again right away.'
                    : 'Entry removed from the history.';
            } else {
                $amfaNotice = 'Not a valid address, nothing was changed.';
                $amfaNoticeKind = 'err';
            }
            break;

        case 'clear_history':
            $amfaGone = aegis_mfa_clear_lockout_history();
            $amfaNotice = $amfaGone === 0
                ? 'Nothing to clear, every entry is still serving its lock.'
                : $amfaGone . ' expired ' . ($amfaGone === 1 ? 'entry' : 'entries') . ' cleared.';
            break;

        case 'sync_users':
            $r = aegis_mfa_sync_users();
            if (($r['skipped'] ?? '') === 'no_live_users') {
                $amfaNotice = 'Sync failed: the Unraid account list could not be read '
                            . '(getent returned nothing usable). Run "aegis-mfa users" '
                            . 'in a terminal to see what the enumeration finds.';
                $amfaNoticeKind = 'err';
            } else {
                if ($r['added']) {
                    $amfaNotice = 'Synced. ' . implode(', ', $r['added'])
                                . ' is now on the list, with a grace window to enrol.';
                } elseif ($r['removed']) {
                    $amfaNotice = 'Synced. ' . implode(', ', $r['removed'])
                                . ' no longer has a webGUI password and came off the list.';
                } else {
                    $amfaNotice = 'Synced. root is already on the list, nothing changed.';
                }
                if (($r['skipped'] ?? '') === 'no_root_in_list') {
                    $amfaNotice .= ' Add-only run: root was missing from the snapshot, '
                                 . 'so nothing was removed.';
                    $amfaNoticeKind = 'warn';
                }
            }
            break;
    }
}

$amfaSum = aegis_mfa_admin_summary();
$amfaPatch = aegis_mfa_patch_state();

$amfaTheme    = aegis_mfa_theme();
$amfaLight    = aegis_mfa_theme_is_light($amfaTheme);
